#!/bin/bash
#SBATCH -p Batch
#SBATCH -N 8
#SBATCH -t 06:00:00
#SBATCH -J qelc_e9_n8
#SBATCH -o out-e9_n8-%j.log

cd "$SLURM_SUBMIT_DIR"
mkdir -p results params
mpirun -N 1 -npernode 1 -n 8 ./job.sh python -u run_qaoa_qarp.py --instance instances_usdc/E5_n31.json --seed 0 --p 1 --maxiter 10 --shots 2000 --init-params params/E4_n30_best.json --out results/e9_n8_seed0.json
