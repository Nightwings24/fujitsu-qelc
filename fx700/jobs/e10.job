#!/bin/bash
#SBATCH -p Batch
#SBATCH -N 1
#SBATCH -t 06:00:00
#SBATCH -J qelc_e10
#SBATCH -o out-e10-%j.log

cd "$SLURM_SUBMIT_DIR"
mkdir -p results params
mpirun -N 1 -npernode 1 -n 1 ./job.sh python -u run_cutting_demo.py --instance instances_usdc/E10_n24_cut.json --params params/E2_n26_best.json --shots 4000 --compare-uncut --out results/e10.json
