#!/bin/bash
#SBATCH -p Batch
#SBATCH -N 1
#SBATCH -t 02:00:00
#SBATCH -J qelc_e1
#SBATCH -o out-e1-%j.log

cd "$SLURM_SUBMIT_DIR"
mkdir -p results params
mpirun -N 1 -npernode 1 -n 1 ./job.sh python -u run_qaoa_qarp.py --instance instances_usdc/E1_n24.json --seed 0 --p 2 --maxiter 60 --shots 10000 --out results/e1_seed0.json
