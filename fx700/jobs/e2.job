#!/bin/bash
#SBATCH -p Batch
#SBATCH -N 1
#SBATCH -t 03:00:00
#SBATCH -J qelc_e2
#SBATCH -o out-e2-%j.log

cd "$SLURM_SUBMIT_DIR"
mkdir -p results params
mpirun -N 1 -npernode 1 -n 1 ./job.sh python -u run_qaoa_qarp.py --instance instances_usdc/E2_n26.json --seed 0 --p 2 --maxiter 60 --shots 10000 --out results/e2_seed0.json
