#!/bin/bash
#SBATCH -p Batch
#SBATCH -N 16
#SBATCH -t 48:00:00
#SBATCH -J qelc_e8
#SBATCH -o out-e8-%j.log

cd "$SLURM_SUBMIT_DIR"
mkdir -p results params
mpirun -N 1 -npernode 1 -n 16 ./job.sh python -u run_qaoa_qarp.py --instance instances_usdc/E8_n34.json --seed 0 --p 1 --skip-optimize --shots 2000 --init-params params/E4_n30_best.json --out results/e8_seed0.json
